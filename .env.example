# Kopieren nach .env und ausfüllen:  cp .env.example .env
# Secrets erzeugen mit:  openssl rand -base64 48

# --- Datenbank ---------------------------------------------------------
POSTGRES_DB=driveonpoint
POSTGRES_USER=driveonpoint
POSTGRES_PASSWORD=

# --- Anwendung ---------------------------------------------------------
# Öffentliche Adresse, ohne Schrägstrich am Ende.
#
# Zum ersten Testen ohne Domain genügt http://localhost:3000 (oder leer
# lassen — das ist der Standardwert). Sitzungs-Cookies laufen dann ohne
# Secure-Schutz, damit sich der Team-Bereich über reines HTTP anmelden lässt.
# Sobald eine Domain steht (siehe SITE_ADDRESS unten), hier auf
# https://deine-domain.ch umstellen und "docker compose up -d" erneut
# ausführen — der Secure-Schutz greift danach automatisch.
APP_URL=http://localhost:3000

# Domain für den mitgelieferten Reverse Proxy (Caddy), der TLS automatisch
# einrichtet (Let's Encrypt) — dafür muss die Domain per DNS bereits auf
# diesen Server zeigen. Zum ersten Testen ohne Domain leer lassen (dann
# hört Caddy auf Port 80 ohne TLS). Sobald die Domain steht: hier eintragen,
# APP_URL oben auf https://dieselbe-domain umstellen, "docker compose up -d
# --build" erneut ausführen.
SITE_ADDRESS=driveonpoint.ch

# Signiert Sitzungs-Cookies. Ändern macht alle Logins ungültig.
SESSION_SECRET=
# Signiert die Captcha-Aufgaben.
CAPTCHA_SECRET=
# Schützt /api/cron/aufraeumen vor fremdem Aufruf.
CRON_SECRET=

# Wie viele Reverse-Proxys vor der App stehen. Bei einem Caddy/nginx: 1.
# Zu hoch gesetzt lässt sich die Rate-Begrenzung durch gefälschte Header umgehen.
TRUST_PROXY_HOPS=1

# Kundendaten werden nach so vielen Tagen automatisch gelöscht.
RETENTION_DAYS=30

# --- Mailversand (freiwillig, aber ohne läuft nur ohne Bestätigungsmails) --
# Ohne eingerichtete Domain kann ohnehin keine Mail zugestellt werden — die
# Anwendung läuft auch ohne diesen Abschnitt und ohne den mail-Container,
# Buchungen werden dann nur ohne Bestätigungsmail angelegt. Erst ausfüllen,
# wenn die Domain und ihre DNS-Einträge stehen (siehe README, Abschnitt
# "Mailversand"), und dann mit "docker compose --profile mail up -d --build"
# starten statt mit dem gewöhnlichen "up -d --build".
#
# Domain, für die der Postfix-Container senden darf. Nur nötig, wenn der
# mitgelieferte mail-Container läuft (siehe unten) — mit einem externen
# Anbieter wie Infomaniak bleiben diese beiden Zeilen ungenutzt.
MAIL_DOMAIN=driveonpoint.ch
MAIL_HOSTNAME=mail.driveonpoint.ch
MAIL_FROM=DriveOnPoint <inbox@driveonpoint.ch>
# Antworten der Kundschaft landen hier statt im Nirgendwo. Am einfachsten
# dieselbe Adresse wie MAIL_FROM — dann kommt eine Antwort im selben
# Postfach an, das ohnehin schon läuft.
MAIL_REPLY_TO=inbox@driveonpoint.ch
# Hierhin gehen Warnungen, wenn Mailversand oder Cron-Läufe stillstehen
# (siehe src/lib/monitoring.ts). Leer = die Kontaktadresse der Website.
# Am besten eine Adresse bei einem anderen Anbieter als dem eigenen
# Mailserver, damit die Warnung auch ankommt, wenn dieser klemmt.
ALERT_EMAIL=
# Link zum Bewertungsformular im Google-Unternehmensprofil: dort unter
# "Rezensionen anfordern" / "Profil teilen" den Link kopieren (beginnt mit
# https://g.page/r/… oder https://search.google.com/local/writereview?…).
# Leer = keine Bewertungsanfragen, der Punkt bleibt im Team-Bereich aus.
GOOGLE_REVIEW_URL=

# Leer lassen für den mitgelieferten Postfix-Container. Für einen externen
# Anbieter — z. B. Infomaniak kSuite — hier Host, Port und Zugangsdaten des
# echten Postfachs eintragen; dann braucht es den mail-Container und das
# --profile mail gar nicht, und MAIL_DOMAIN/MAIL_HOSTNAME oben spielen keine
# Rolle. Bei Infomaniak: SMTP_HOST=mail.infomaniak.com, SMTP_PORT=587,
# SMTP_SECURE=false, SMTP_USER/SMTP_PASS wie im kSuite-Postfach eingerichtet
# (genauer Hostname steht in den kSuite-Mail-Einstellungen — dort prüfen).
SMTP_HOST=mail
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Zwei-Faktor-Authentifizierung (MFA) per Authenticator-App braucht keine
# eigene Einrichtung hier — jede Person schaltet sie selbst unter
# "Mein Konto" ein, per QR-Code. Läuft vollständig lokal, ohne fremden Dienst.

# --- Erstes Administratorkonto ----------------------------------------
# Wird beim ersten Start des app-Containers einmalig angelegt (kein
# separater Befehl nötig). Danach beide Zeilen leeren und "docker compose
# up -d" erneut ausführen.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
