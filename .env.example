# Kopieren nach .env und ausfüllen:  cp .env.example .env
# Secrets erzeugen mit:  openssl rand -base64 48

# --- Datenbank ---------------------------------------------------------
POSTGRES_DB=driveonpoint
POSTGRES_USER=driveonpoint
POSTGRES_PASSWORD=

# --- Anwendung ---------------------------------------------------------
# Öffentliche Adresse, ohne Schrägstrich am Ende.
#
# Zum ersten Testen ohne Domain genügt http://localhost:3000 (oder leer
# lassen — das ist der Standardwert). Sitzungs-Cookies laufen dann ohne
# Secure-Schutz, damit sich der Team-Bereich über reines HTTP anmelden lässt.
# Sobald eine Domain und ein Reverse Proxy mit TLS stehen, hier auf
# https://deine-domain.ch umstellen und "docker compose up -d" erneut
# ausführen — der Secure-Schutz greift danach automatisch.
APP_URL=http://localhost:3000

# Signiert Sitzungs-Cookies. Ändern macht alle Logins ungültig.
SESSION_SECRET=
# Signiert die Captcha-Aufgaben.
CAPTCHA_SECRET=
# Schützt /api/cron/retention vor fremdem Aufruf.
CRON_SECRET=

# Wie viele Reverse-Proxys vor der App stehen. Bei einem Caddy/nginx: 1.
# Zu hoch gesetzt lässt sich die Rate-Begrenzung durch gefälschte Header umgehen.
TRUST_PROXY_HOPS=1

# Kundendaten werden nach so vielen Tagen automatisch gelöscht.
RETENTION_DAYS=30

# --- Mailversand (freiwillig, aber ohne läuft nur ohne Bestätigungsmails) --
# Ohne eingerichtete Domain kann ohnehin keine Mail zugestellt werden — die
# Anwendung läuft auch ohne diesen Abschnitt und ohne den mail-Container,
# Buchungen werden dann nur ohne Bestätigungsmail angelegt. Erst ausfüllen,
# wenn die Domain und ihre DNS-Einträge stehen (siehe README, Abschnitt
# "Mailversand"), und dann mit "docker compose --profile mail up -d --build"
# starten statt mit dem gewöhnlichen "up -d --build".
#
# Domain, für die der Postfix-Container senden darf.
MAIL_DOMAIN=driveonpoint.ch
MAIL_HOSTNAME=mail.driveonpoint.ch
MAIL_FROM=DriveOnPoint <noreply@driveonpoint.ch>
# Antworten der Kundschaft landen hier statt im Nirgendwo.
MAIL_REPLY_TO=info@driveonpoint.ch

# Leer lassen für den mitgelieferten Postfix-Container.
# Für einen externen Anbieter hier Host, Port und Zugangsdaten eintragen —
# dann braucht es den mail-Container und das --profile mail gar nicht.
SMTP_HOST=mail
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Anmeldung über Google (freiwillig) -------------------------------
# Beide Zeilen leer lassen, und der Google-Knopf erscheint gar nicht erst.
#
# Einrichten in der Google Cloud Console: Projekt anlegen, OAuth-Zustimmungs-
# bildschirm ausfüllen, dann "OAuth-Client-ID" vom Typ Webanwendung erzeugen.
# Als autorisierten Weiterleitungs-URI genau eintragen:
#   https://driveonpoint.ch/api/auth/google/callback
#
# Anmelden kann sich danach nur, wer hier bereits ein aktives Konto hat.
# Ein Google-Konto allein öffnet nichts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Erstes Administratorkonto ----------------------------------------
# Wird beim ersten Start des app-Containers einmalig angelegt (kein
# separater Befehl nötig). Danach beide Zeilen leeren und "docker compose
# up -d" erneut ausführen.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
